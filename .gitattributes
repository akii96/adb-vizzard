# Normalise line endings so the repo is consistent regardless of the machine that
# committed. Without this, Windows checkouts produce whitespace-only diffs.
* text=auto eol=lf

# Windows-native tooling; keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.icns binary
*.xlsx binary

# Fixture artifacts are byte-compared by the golden tests, so they must not be
# touched by line-ending conversion.
fixtures/** -text

# Collapse lockfile noise in reviews.
package-lock.json linguist-generated=true -diff
src-tauri/Cargo.lock linguist-generated=true -diff
